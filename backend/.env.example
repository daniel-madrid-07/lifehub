# Copia este archivo a .env y rellena lo que vayas a usar.
# Todo es opcional salvo APP_PASSWORD: los módulos sin configurar simplemente
# no aparecen, no rompen la app.

# ── Acceso ──────────────────────────────────────────────────────────────────
# Clave única de la API. OBLIGATORIA en cualquier despliegue accesible desde
# fuera: sin ella la API queda abierta y cualquiera puede leer tus datos.
# Genérala con: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_PASSWORD=

# Token propio del reloj (solo vale para /api/gym/device/*), para no meter la
# clave principal en el firmware del Watch.
GYM_DEVICE_TOKEN=

# ── General ─────────────────────────────────────────────────────────────────
# Zona horaria para horarios, rachas y el corte del día.
TIMEZONE=Europe/Madrid

# URL pública de tu instancia. Se usa en los avisos y como base del callback
# de Google OAuth (<APP_URL>/api/auth/google/callback).
APP_URL=http://localhost:8000

# ── IA (opcional) ───────────────────────────────────────────────────────────
# Resúmenes, coach y detección de eventos. Sin clave, esas secciones se ocultan.
ANTHROPIC_API_KEY=

# ── Avisos por Telegram (opcional) ──────────────────────────────────────────
# Crea un bot con @BotFather. Solo se usa como fallback: los avisos normales
# van por notificaciones push de la app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Correo y agenda de Google (opcional) ────────────────────────────────────
# Cliente OAuth tipo Web en https://console.cloud.google.com/
# (APIs & Services -> Credentials). Registra como redirect URI:
#   <APP_URL>/api/auth/google/callback
# Luego ejecuta `python google_auth.py` una vez para generar token.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ponlo a 1 si tu cliente OAuth está en modo Producción (el refresh token no
# caduca y desaparece la cuenta atrás de 7 días).
GOOGLE_PROD=

# ── Calendario de iCloud (opcional) ─────────────────────────────────────────
# Contraseña de app creada en https://account.apple.com
# (Inicio de sesión y seguridad -> Contraseñas de apps).
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=

# ── Estudios (opcional) ─────────────────────────────────────────────────────
# El coach mira los repos de una organización de GitHub y te dice cómo vas.
# Sin STUDIES_GH_ORG el módulo entero se apaga.
STUDIES_GH_TOKEN=
STUDIES_GH_ORG=
# Cómo se evalúa en tu centro; se le pasa a la IA como contexto.
# STUDIES_CONTEXT=Proyectos corregidos con tests automáticos y una norma de estilo estricta.
# Regex opcional si los repos siguen un patrón: 3 grupos (código, instancia, slug).
# STUDIES_REPO_RE=^(G-[A-Z]+-\d+)-([A-Z]{2,4}-\d+-\d+)-(.+)-\d+$

# API propia que sirva enunciados y deadlines (opcional).
INTRA_API_URL=http://127.0.0.1:8000
INTRA_API_KEY=
INTRA_SESSION_PATH=

# ── Finanzas (opcional) ─────────────────────────────────────────────────────
# Alpaca (bolsa, la URL por defecto es la de paper trading).
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Bitvavo (cripto). Ojo: su API permite restringir por IP, úsalo.
BITVAVO_API_KEY=
BITVAVO_API_SECRET=
# Alternativa: leer las claves de otro .env en vez de repetirlas aquí.
# MARKETPULSE_ENV_FILE=/opt/marketpulse/.env
